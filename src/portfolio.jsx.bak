// ============================================================
// portfolio.jsx  —  Vincent Assogba Portfolio
// Imports all data & base64 assets from ./data.js
// Stack: React · CSS-in-JS · SVG icons · IntersectionObserver
// Charte: #0F172A · #1E3A8A · #14B8A6 · #F8FAFC · #FFFFFF
// Fonts: DM Serif Display (headings) · Cabinet Grotesk (body)
// ============================================================

import { useState, useEffect, useRef } from "react";
import {
  ASSETS, PROFILE, STATS, EDUCATION,
  SKILLS, TOOLS, RESEARCH,
  CERTIFICATIONS, ATTESTATIONS,
  SERVICES, INTERESTS,
} from "./data.js";

/* ─────────────────────────────────────────────────────
   SVG ICON LIBRARY  (no emojis, pure SVG)
───────────────────────────────────────────────────── */
const Icon = ({ name, size = 20, color = "currentColor", stroke = 1.8 }) => {
  const s = { width: size, height: size, display: "block", flexShrink: 0 };
  const paths = {
    // Navigation & UI
    menu:         <><line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></>,
    x:            <><line x1="18" y1="6"  x2="6"  y2="18"/><line x1="6"  y1="6"  x2="18" y2="18"/></>,
    chevronDown:  <polyline points="6 9 12 15 18 9"/>,
    chevronRight: <polyline points="9 18 15 12 9 6"/>,
    arrowDown:    <><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></>,
    externalLink: <><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></>,
    download:     <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></>,
    send:         <><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></>,
    check:        <polyline points="20 6 9 17 4 12"/>,
    // Contact & Social
    mail:         <><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></>,
    phone:        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.69a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>,
    mapPin:       <><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></>,
    linkedin:     <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></>,
    github:       <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>,
    microscope:   <><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></>,
    // Content
    graduation:   <><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></>,
    briefcase:    <><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></>,
    chart:        <><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6"  y1="20" x2="6"  y2="14"/></>,
    activity:     <polyline points="22 12 18 12 15 20 9 4 6 12 2 12"/>,
    database:     <><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></>,
    search:       <><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></>,
    book:         <><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></>,
    award:        <><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></>,
    fileText:     <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></>,
    cpu:          <><rect x="9" y="9" width="6" height="6"/><path d="M20 14h1M20 10h1M4 14H3M4 10H3M14 4V3M10 4V3M14 21v-1M10 21v-1M3 7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/></>,
    trendingUp:   <><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></>,
    globe:        <><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></>,
    layers:       <><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></>,
    zap:          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>,
    leaf:         <path d="M2 22 16 8M16.94 6.06a1.5 1.5 0 0 0-2.12 0l-.01.01A10 10 0 0 0 12 13a10 10 0 0 0-3 6.76A10 10 0 0 0 20.76 8 10 10 0 0 0 16.94 6.06z"/>,
    sun:          <><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></>,
    bitcoin:      <path d="M11.767 19.089c4.924.868 6.14-6.025 1.216-6.894m-1.216 6.894L5.86 18.047m5.908 1.042-.347 1.97m1.563-8.864c4.924.869 6.14-6.025 1.215-6.893m-1.215 6.893-3.94-.694m5.155-6.2L8.29 4.26m5.908 1.042.348-1.97M7.48 20.364l3.126-17.727"/>,
    users:        <><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></>,
    target:       <><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></>,
    settings:     <><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></>,
    barChart:     <><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6"  y1="20" x2="6"  y2="16"/></>,
    pieChart:     <><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></>,
    code:         <><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></>,
  };
  return (
    <svg style={s} viewBox="0 0 24 24" fill="none" stroke={color}
      strokeWidth={stroke} strokeLinecap="round" strokeLinejoin="round">
      {paths[name] || <circle cx="12" cy="12" r="10"/>}
    </svg>
  );
};

/* ─────────────────────────────────────────────────────
   GLOBAL CSS
───────────────────────────────────────────────────── */
const GlobalCSS = () => (
  <style>{`
@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Cabinet+Grotesk:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:     #0F172A;
  --cobalt:   #1E3A8A;
  --teal:     #14B8A6;
  --teal-d:   #0F9489;
  --teal-l:   #CCFBF1;
  --teal-ll:  #F0FDFA;
  --bg:       #F8FAFC;
  --surface:  #FFFFFF;
  --border:   #E2E8F0;
  --border-d: #CBD5E1;
  --text:     #1E293B;
  --muted:    #64748B;
  --muted-l:  #94A3B8;
  --cobalt-l: #EEF2FF;
  --gold:     #D97706;
  --gold-l:   #FEF3C7;
  --shadow-xs: 0 1px 2px rgba(15,23,42,.06);
  --shadow-sm: 0 2px 8px rgba(15,23,42,.08),0 1px 2px rgba(15,23,42,.05);
  --shadow-md: 0 8px 24px rgba(15,23,42,.1),0 2px 6px rgba(15,23,42,.06);
  --shadow-lg: 0 20px 48px rgba(15,23,42,.12),0 6px 16px rgba(15,23,42,.07);
  --shadow-teal: 0 8px 28px rgba(20,184,166,.28);
  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 22px;
  --r-xl: 30px;
}

html{scroll-behavior:smooth}
body{
  font-family:'Cabinet Grotesk',sans-serif;
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--teal);border-radius:2px}
::selection{background:var(--teal);color:#fff}

/* ── Keyframes ── */
@keyframes fadeUp    {from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeLeft  {from{opacity:0;transform:translateX(-32px)}to{opacity:1;transform:translateX(0)}}
@keyframes fadeRight {from{opacity:0;transform:translateX(32px)}to{opacity:1;transform:translateX(0)}}
@keyframes zoomIn    {from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
@keyframes float     {0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes blink     {0%,100%{opacity:1}50%{opacity:0}}
@keyframes spin      {to{transform:rotate(360deg)}}
@keyframes blob      {0%,100%{border-radius:60% 40% 55% 45%/50% 60% 40% 50%}33%{border-radius:45% 55% 40% 60%/55% 45% 55% 45%}66%{border-radius:55% 45% 60% 40%/45% 55% 45% 55%}}
@keyframes pulse     {0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.08);opacity:1}}
@keyframes shimmer   {0%{background-position:-400px 0}100%{background-position:400px 0}}
@keyframes countUp   {from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}
@keyframes lineGrow  {from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes gradFlow  {0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}

/* ── Reveal classes (activated by IntersectionObserver) ── */
.reveal{opacity:0}
.reveal.up   {animation:fadeUp   .65s ease both}
.reveal.left {animation:fadeLeft .65s ease both}
.reveal.right{animation:fadeRight .65s ease both}
.reveal.zoom {animation:zoomIn   .55s ease both}

.d1{animation-delay:.06s}.d2{animation-delay:.14s}.d3{animation-delay:.22s}
.d4{animation-delay:.30s}.d5{animation-delay:.38s}.d6{animation-delay:.46s}
.d7{animation-delay:.54s}.d8{animation-delay:.62s}.d9{animation-delay:.70s}

/* ── Layout ── */
.wrap{max-width:1160px;margin:0 auto;padding:0 32px}
section{padding:96px 0;position:relative}

/* ── Eyebrow label ── */
.eyebrow{
  display:inline-flex;align-items:center;gap:7px;
  font-family:'JetBrains Mono',monospace;
  font-size:10.5px;font-weight:500;letter-spacing:2px;text-transform:uppercase;
  color:var(--teal);background:var(--teal-ll);
  border:1px solid rgba(20,184,166,.2);
  padding:5px 13px;border-radius:20px;margin-bottom:14px;
}
.eyebrow-line{width:18px;height:1.5px;background:var(--teal);border-radius:1px}

/* ── Section title ── */
.s-title{
  font-family:'DM Serif Display',serif;
  font-size:clamp(30px,4.5vw,48px);
  font-weight:400;line-height:1.18;
  color:var(--navy);margin-bottom:12px;
}
.s-title .accent{color:var(--teal)}
.s-title .cobalt{color:var(--cobalt)}
.s-desc{font-size:15px;color:var(--muted);max-width:520px;line-height:1.78}

/* ── Card base ── */
.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--r-lg);
  box-shadow:var(--shadow-sm);
  transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease;
  position:relative;overflow:hidden;
}
.card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:rgba(20,184,166,.3)}

/* ── Buttons ── */
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 24px;border-radius:50px;
  font-family:'Cabinet Grotesk',sans-serif;
  font-size:14px;font-weight:700;
  cursor:pointer;transition:all .22s ease;
  text-decoration:none;border:none;letter-spacing:.2px;
}
.btn-teal{background:linear-gradient(135deg,var(--teal),var(--teal-d));color:#fff;box-shadow:var(--shadow-teal)}
.btn-teal:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(20,184,166,.38)}
.btn-navy{background:var(--navy);color:#fff}
.btn-navy:hover{background:#1e2d4a;transform:translateY(-2px)}
.btn-ghost{background:transparent;color:var(--navy);border:2px solid var(--border)}
.btn-ghost:hover{border-color:var(--teal);color:var(--teal);background:var(--teal-ll)}
.btn-white{background:rgba(255,255,255,.12);backdrop-filter:blur(8px);color:#fff;border:1px solid rgba(255,255,255,.2)}
.btn-white:hover{background:rgba(255,255,255,.2);border-color:rgba(255,255,255,.4)}

/* ── Tag / badge ── */
.tag{
  display:inline-block;padding:4px 11px;border-radius:20px;
  font-size:11px;font-weight:700;letter-spacing:.3px;
  background:var(--teal-ll);color:var(--teal);
  border:1px solid rgba(20,184,166,.22);
}
.tag-blue{background:var(--cobalt-l);color:var(--cobalt);border-color:rgba(30,58,138,.2)}
.tag-gold{background:var(--gold-l);color:var(--gold);border-color:rgba(217,119,6,.2)}

/* ══ NAV ══ */
#nav{position:fixed;top:0;left:0;right:0;z-index:300;transition:all .3s}
#nav.solid{background:rgba(248,250,252,.96);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);box-shadow:var(--shadow-xs)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:15px 32px;max-width:1160px;margin:0 auto}
.nav-brand{display:flex;align-items:center;gap:11px;cursor:pointer;text-decoration:none}
.nav-mark{
  width:38px;height:38px;border-radius:10px;
  background:linear-gradient(135deg,var(--cobalt),var(--teal));
  display:flex;align-items:center;justify-content:center;
  font-family:'DM Serif Display',serif;font-size:17px;color:#fff;font-weight:400;
}
.nav-name{font-family:'DM Serif Display',serif;font-size:17px;color:var(--navy)}
.nav-sub{font-size:10px;color:var(--muted);font-weight:500;margin-top:1px}
.nav-links{display:flex;align-items:center;gap:2px}
.nav-btn{
  background:none;border:none;cursor:pointer;padding:7px 13px;border-radius:8px;
  font-family:'Cabinet Grotesk',sans-serif;font-size:13px;font-weight:600;
  color:var(--muted);transition:all .2s;
}
.nav-btn:hover,.nav-btn.active{color:var(--teal);background:var(--teal-ll)}

/* ══ HERO ══ */
#hero{
  min-height:100vh;
  background:linear-gradient(145deg,var(--navy) 0%,#152340 55%,#0d1c35 100%);
  display:flex;align-items:center;overflow:hidden;
}
.hero-mesh{
  position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(ellipse 60% 50% at 70% 40%,rgba(30,58,138,.35),transparent),
    radial-gradient(ellipse 40% 40% at 20% 70%,rgba(20,184,166,.12),transparent),
    radial-gradient(ellipse 30% 30% at 85% 80%,rgba(20,184,166,.07),transparent);
}
.hero-grid{
  position:absolute;inset:0;pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:64px 64px;
}
.hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;z-index:1;padding-top:88px}
.hero-eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:22px}
.hero-pulse{width:9px;height:9px;border-radius:50%;background:var(--teal);animation:pulse 2.2s ease-in-out infinite}
.hero-pulse-ring{position:absolute;width:9px;height:9px;border-radius:50%;border:2px solid var(--teal);animation:pulse 2.2s ease-in-out infinite;opacity:.4}
.hero-eyebrow-text{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;letter-spacing:2px;color:rgba(255,255,255,.45);text-transform:uppercase}
.hero-name{font-family:'DM Serif Display',serif;font-size:clamp(40px,5.5vw,68px);font-weight:400;line-height:1.08;color:#fff;margin-bottom:14px}
.hero-name .teal{color:var(--teal)}
.hero-typed-row{display:flex;align-items:center;gap:10px;height:36px;margin-bottom:22px}
.hero-typed{font-family:'Cabinet Grotesk',sans-serif;font-size:17px;font-weight:600;color:rgba(255,255,255,.65)}
.hero-cursor{width:2px;height:20px;background:var(--teal);animation:blink 1s step-end infinite}
.hero-desc{font-size:15px;color:rgba(255,255,255,.48);line-height:1.82;max-width:470px;margin-bottom:34px}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:44px}
.hero-meta{display:flex;flex-direction:column;gap:10px}
.hero-meta-row{display:flex;align-items:center;gap:10px;font-size:13px;color:rgba(255,255,255,.38)}
.hero-meta-row strong{color:rgba(255,255,255,.7);font-weight:500}
/* Photo */
.hero-photo-wrap{display:flex;align-items:center;justify-content:center;position:relative}
.hero-ring{position:absolute;border-radius:50%;border:1px solid rgba(20,184,166,.1);animation:spin linear infinite}
.hero-blob{
  width:300px;height:360px;
  animation:blob 9s ease-in-out infinite;
  overflow:hidden;
  border:3px solid rgba(20,184,166,.35);
  box-shadow:0 0 60px rgba(20,184,166,.1),0 30px 80px rgba(0,0,0,.45);
  background:linear-gradient(135deg,var(--cobalt),#0d1c35);
  display:flex;align-items:center;justify-content:center;
}
.hero-blob img{width:100%;height:100%;object-fit:cover;object-position:top center}
.hero-float-badge{
  position:absolute;
  background:rgba(255,255,255,.09);backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.15);border-radius:14px;
  padding:10px 16px;animation:float 5s ease-in-out infinite;
}
.hfb-val{font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:500;color:var(--teal)}
.hfb-lbl{font-size:10px;color:rgba(255,255,255,.45);margin-top:2px;font-weight:500}
.scroll-hint{position:absolute;bottom:30px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer}
.scroll-hint span{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.25)}
.scroll-hint-line{width:1px;height:32px;background:linear-gradient(to bottom,rgba(20,184,166,.5),transparent);animation:float 2.5s ease-in-out infinite}

/* ══ ABOUT ══ */
#about{background:var(--surface)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
.about-photo{border-radius:var(--r-xl);overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-lg);aspect-ratio:4/5;background:linear-gradient(135deg,var(--cobalt-l),var(--teal-ll));display:flex;align-items:flex-end;justify-content:center;position:relative}
.about-photo img{width:100%;height:100%;object-fit:cover;object-position:top center;position:absolute;inset:0}
.about-photo-overlay{position:absolute;bottom:0;left:0;right:0;padding:20px 24px;background:linear-gradient(to top,rgba(15,23,42,.9),transparent)}
.about-photo-name{font-family:'DM Serif Display',serif;font-size:18px;color:#fff}
.about-photo-title{font-size:12px;color:rgba(255,255,255,.55);margin-top:3px;font-weight:500}
.about-domains{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:26px}
.about-domain{display:flex;align-items:center;gap:10px;padding:11px 15px;border-radius:var(--r-sm);background:var(--bg);border:1px solid var(--border);font-size:13px;font-weight:600;color:var(--text);transition:all .25s}
.about-domain:hover{background:var(--teal-ll);border-color:rgba(20,184,166,.3);color:var(--teal)}
.about-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}
.about-meta-item{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-sm);padding:12px 16px}
.ami-key{font-family:'JetBrains Mono',monospace;font-size:9.5px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);margin-bottom:3px}
.ami-val{font-size:13px;font-weight:700;color:var(--text)}

/* ══ STATS ══ */
#stats{
  background:linear-gradient(135deg,var(--navy) 0%,var(--cobalt) 100%);
  padding:72px 0;
}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr)}
.stat-cell{text-align:center;padding:44px 20px;border-right:1px solid rgba(255,255,255,.08)}
.stat-cell:last-child{border-right:none}
.stat-icon-wrap{width:52px;height:52px;border-radius:14px;background:rgba(20,184,166,.15);border:1px solid rgba(20,184,166,.25);display:flex;align-items:center;justify-content:center;margin:0 auto 18px}
.stat-n{font-family:'DM Serif Display',serif;font-size:54px;font-weight:400;color:var(--teal);line-height:1;margin-bottom:8px}
.stat-lbl{font-size:13px;font-weight:700;color:rgba(255,255,255,.8);margin-bottom:3px}
.stat-sub{font-size:12px;color:rgba(255,255,255,.35);font-weight:500}

/* ══ EDUCATION ══ */
#education{background:var(--bg)}
.tl{position:relative;padding-left:60px}
.tl-spine{position:absolute;left:19px;top:10px;bottom:10px;width:2px;background:linear-gradient(to bottom,var(--teal),var(--cobalt),transparent);border-radius:1px}
.tl-item{position:relative;margin-bottom:30px}
.tl-item:last-child{margin-bottom:0}
.tl-dot{position:absolute;left:-50px;top:10px;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:1;box-shadow:0 0 0 5px var(--bg),0 0 0 7px rgba(20,184,166,.18)}
.tl-year{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:500;color:var(--teal);background:var(--teal-ll);border:1px solid rgba(20,184,166,.22);padding:3px 11px;border-radius:20px;margin-bottom:10px}

/* ══ SKILLS ══ */
#skills{background:var(--surface)}
.skills-split{display:grid;grid-template-columns:1fr 1.1fr;gap:72px;align-items:start}
.skill-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-top:28px}
.skill-tab{padding:8px 18px;border-radius:24px;font-size:13px;font-weight:700;cursor:pointer;border:1.5px solid;transition:all .2s;font-family:'Cabinet Grotesk',sans-serif}
.skill-tab.on{background:var(--teal);color:#fff;border-color:var(--teal)}
.skill-tab.off{background:transparent;color:var(--muted);border-color:var(--border)}
