/* ─────────────────────────────────────────────────────
   SECTION 5 — COMPÉTENCES
───────────────────────────────────────────────────── */
const SKILL_TABS = [
  {label:"Économétrie",         icon:"barChart", data:SKILLS.econometrie},
  {label:"Statistiques",        icon:"activity", data:SKILLS.statistiques},
  {label:"Gestion des données", icon:"database", data:SKILLS.donnees},
];

const SkillBar = ({ name, pct, active, delay }) => {
  const fillRef = useRef(null);
  useEffect(() => {
    if (active && fillRef.current) {
      const id = setTimeout(() => fillRef.current?.classList.add("on"), delay*1000+350);
      return () => clearTimeout(id);
    } else fillRef.current?.classList.remove("on");
  }, [active, delay]);
  return (
    <div className="skill-row">
      <div className="skill-head">
        <span>{name}</span>
        <span className="skill-pct">{pct}%</span>
      </div>
      <div className="skill-track">
        <div ref={fillRef} className="skill-fill" style={{width:`${pct}%`}}/>
      </div>
    </div>
  );
};

const Skills = () => {
  const [ref,vis] = useInView();
  const [tab,setTab] = useState(0);
  return (
    <section id="skills">
      <div className="wrap" ref={ref}>
        <div className="skills-split">
          <div className={`reveal left${vis?" vis":""}`}>
            <div className="eyebrow"><div className="eyebrow-line"/>Compétences techniques</div>
            <h2 className="s-title">Expertise <span className="accent">Quantitative</span></h2>
            <p className="s-desc">Maîtrise des méthodes économétriques modernes, des tests statistiques et des outils d'analyse de données.</p>
            <div className="skill-tabs">
              {SKILL_TABS.map((t,i)=>(
                <button key={t.label} className={`skill-tab ${tab===i?"on":"off"}`} onClick={()=>setTab(i)}>
                  <span style={{display:"flex",alignItems:"center",gap:6}}>
                    <Icon name={t.icon} size={14} color={tab===i?"#fff":"var(--muted)"}/>
                    {t.label}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <div className={`reveal right${vis?" vis":""} d2`}>
            <div className="card" style={{padding:28}}>
              <div style={{display:"flex",alignItems:"center",gap:10,marginBottom:22,fontFamily:"'DM Serif Display',serif",fontSize:17,color:"var(--navy)"}}>
                <Icon name={SKILL_TABS[tab].icon} size={20} color="var(--teal)"/>
                {SKILL_TABS[tab].label}
              </div>
              {SKILL_TABS[tab].data.map((s,i)=>(
                <SkillBar key={s.name} name={s.name} pct={s.pct} active={vis} delay={i*0.1}/>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  );
};

