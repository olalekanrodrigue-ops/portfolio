/* ─────────────────────────────────────────────────────
   SECTION 3 — STATISTIQUES ANIMÉES
───────────────────────────────────────────────────── */
const StatCell = ({ n, label, sub, iconName, active }) => {
  const val = useCounter(n, active);
  return (
    <div className="stat-cell">
      <div className="stat-icon-wrap">
        <Icon name={iconName} size={22} color="var(--teal)"/>
      </div>
      <div className="stat-n">{val}+</div>
      <div className="stat-lbl">{label}</div>
      <div className="stat-sub">{sub}</div>
    </div>
  );
};

const STAT_ICONS = ["graduation","award","fileText","cpu"];

const Stats = () => {
  const [ref,vis] = useInView(0.3);
  return (
    <section id="stats" style={{padding:"72px 0"}}>
      <div className="wrap" ref={ref}>
        <div className="stats-row">
          {STATS.map((s,i) => (
            <div key={i} className={`reveal up${vis?" vis":""}`} style={{animationDelay:`${i*0.12}s`}}>
              <StatCell n={s.n} label={s.label} sub={s.sub} iconName={STAT_ICONS[i]} active={vis}/>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
};

/* ─────────────────────────────────────────────────────
   SECTION 4 — FORMATION ACADÉMIQUE
───────────────────────────────────────────────────── */
