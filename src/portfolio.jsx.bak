.skill-track{height:6px;background:var(--border);border-radius:3px;overflow:hidden}
.skill-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--teal),var(--cobalt));transform-origin:left;transform:scaleX(0);transition:transform 1.1s cubic-bezier(.4,0,.2,1)}
.skill-fill.on{transform:scaleX(1)}

/* ══ TOOLS ══ */
#tools{background:var(--bg)}
.tools-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px}
.tool-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:24px 16px;text-align:center;box-shadow:var(--shadow-xs);transition:all .3s;cursor:default}
.tool-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:rgba(20,184,166,.3)}
.tool-card:hover .tool-icon-wrap{background:var(--teal);border-color:var(--teal)}
