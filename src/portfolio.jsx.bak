  font-family:'Cabinet Grotesk',sans-serif;font-size:14px;font-weight:500;color:var(--text);
  outline:none;transition:border-color .2s,background .2s;
}
.f-input::placeholder{color:var(--muted-l)}
.f-input:focus{border-color:var(--teal);background:var(--surface)}
textarea.f-input{resize:vertical;min-height:115px}

/* ══ FOOTER ══ */
footer{background:var(--navy);padding:48px 0}
.footer-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
.footer-brand-name{font-family:'DM Serif Display',serif;font-size:18px;color:#fff;margin-bottom:3px}
.footer-brand-tag{font-size:11px;color:rgba(255,255,255,.35);font-weight:500}
.footer-copy{font-size:12px;color:rgba(255,255,255,.3);font-weight:500}
.footer-icons{display:flex;gap:10px}
.f-icon-btn{width:36px;height:36px;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;text-decoration:none}
.f-icon-btn:hover{background:var(--teal);border-color:var(--teal)}
.footer-nav{border-top:1px solid rgba(255,255,255,.07);margin-top:24px;padding-top:20px;display:flex;justify-content:center;gap:24px;flex-wrap:wrap}
.f-nav-btn{background:none;border:none;cursor:pointer;font-size:12px;color:rgba(255,255,255,.28);font-family:'Cabinet Grotesk',sans-serif;font-weight:500;transition:color .2s}
.f-nav-btn:hover{color:var(--teal)}

/* ── Responsive ── */
@media(max-width:900px){
  .hero-inner,.about-grid,.contact-grid{grid-template-columns:1fr}
  .hero-photo-wrap{display:none}
  .stats-row{grid-template-columns:1fr 1fr}
  .research-grid,.attest-grid,.services-grid{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  .skills-split{grid-template-columns:1fr}
  .hero-btns{flex-direction:column;align-items:flex-start}
}
@media(max-width:600px){
  section{padding:64px 0}
  .wrap{padding:0 18px}
  .stats-row{grid-template-columns:1fr 1fr}
  .tools-grid{grid-template-columns:repeat(3,1fr)}
  .certs-grid{grid-template-columns:1fr}
}
`}</style>
);

/* ─────────────────────────────────────────────────────
   HOOKS
───────────────────────────────────────────────────── */
const useInView = (threshold = 0.12) => {
  const ref = useRef(null);
  const [vis, setVis] = useState(false);
  useEffect(() => {
    const io = new IntersectionObserver(
      ([e]) => { if (e.isIntersecting) { setVis(true); io.disconnect(); } },
      { threshold }
    );
    if (ref.current) io.observe(ref.current);
    return () => io.disconnect();
  }, [threshold]);
  return [ref, vis];
};

const useCounter = (target, active, ms = 1400) => {
  const [n, setN] = useState(0);
  useEffect(() => {
    if (!active) return;
    let cur = 0; const step = target / (ms / 16);
    const id = setInterval(() => {
      cur += step;
      if (cur >= target) { setN(target); clearInterval(id); }
      else setN(Math.floor(cur));
    }, 16);
    return () => clearInterval(id);
  }, [target, active, ms]);
  return n;
};

/* ─────────────────────────────────────────────────────
   NAV ITEMS
───────────────────────────────────────────────────── */
const NAV = [
  ["Accueil","hero"],["À Propos","about"],["Formation","education"],
  ["Compétences","skills"],["Outils","tools"],["Recherches","research"],
  ["Certifications","certifications"],["Services","services"],["Contact","contact"],
];
const go = id => document.getElementById(id)?.scrollIntoView({ behavior:"smooth" });

/* ─────────────────────────────────────────────────────
   TYPED STRING HOOK
───────────────────────────────────────────────────── */
const TYPED_WORDS = ["Économètre","Data Analyst","Chercheur Économique","Spécialiste ARDL","Consultant données"];
const useTyped = () => {
  const [word, setWord] = useState("");
  const [wi, setWi] = useState(0);
  const [ci, setCi] = useState(0);
  const [del, setDel] = useState(false);
  useEffect(() => {
    const t = setTimeout(() => {
      const w = TYPED_WORDS[wi];
      if (!del) {
        if (ci < w.length) { setWord(w.slice(0, ci+1)); setCi(c=>c+1); }
        else setTimeout(() => setDel(true), 1900);
      } else {
        if (ci > 0) { setWord(w.slice(0, ci-1)); setCi(c=>c-1); }
        else { setDel(false); setWi(i=>(i+1)%TYPED_WORDS.length); }
      }
    }, del ? 52 : 92);
    return () => clearTimeout(t);
  }, [word, wi, ci, del]);
  return word;
};

