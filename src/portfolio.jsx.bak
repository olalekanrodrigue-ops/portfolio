/* ══ RESEARCH ══ */
#research{background:var(--surface)}
.research-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.rc{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--shadow-sm);transition:all .35s}
