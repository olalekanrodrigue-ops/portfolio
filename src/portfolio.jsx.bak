                <div>
                  <div className="cert-issuer" style={{color:c.issuerColor}}>{c.issuer}</div>
                  <div className="cert-title">{c.title}</div>
                </div>
              </div>
              <p className="cert-desc">{c.desc}</p>
              <div className="cert-skills">
                {c.skills.map(s=>(
                  <span key={s} style={{padding:"3px 10px",borderRadius:12,fontSize:10.5,fontWeight:700,background:`${c.issuerColor}14`,color:c.issuerColor,border:`1px solid ${c.issuerColor}28`}}>{s}</span>
                ))}
              </div>
              <div className="cert-foot">
                <div style={{display:"flex",alignItems:"center",gap:6}}>
                  <Icon name="check" size={13} color="#22C55E"/>
                  <span className="cert-year">Obtenu en {c.year}</span>
                </div>
                <div className="cert-stars">
                  {[1,2,3,4,5].map(s=>(
                    <svg key={s} width="13" height="13" viewBox="0 0 24 24" fill={s<=4?c.issuerColor:"var(--border)"} stroke="none">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
};

