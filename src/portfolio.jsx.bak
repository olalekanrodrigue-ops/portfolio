          <p className="s-desc">Certifications Google obtenues via Coursera — référence mondiale de formation professionnelle.</p>
        </div>

        <div className="certs-grid">
          {CERTIFICATIONS.map((c,i) => (
            <div key={i} className={`cert-card reveal up${vis?" vis":""}`} style={{animationDelay:`${.1+i*.12}s`}}>
              <div className="cert-top-bar" style={{background:CERT_BARS[i]}}/>
              <div className="cert-head">
                <div className="cert-logo-box" style={{background:`${c.issuerColor}18`,border:`1px solid ${c.issuerColor}30`}}>
                  <Icon name="award" size={24} color={c.issuerColor}/>
