  "EViews":    { icon:"activity",  color:"#0F766E" },
  "R":         { icon:"chart",     color:"#276DC3" },
  "RStudio":   { icon:"code",      color:"#75AADB" },
  "Python":    { icon:"cpu",       color:"#306998" },
  "Excel":     { icon:"pieChart",  color:"#217346" },
  "CsPro":     { icon:"database",  color:"#64748B" },
  "Stata GMM": { icon:"settings",  color:"#1E3A8A" },
};
const INTEREST_ICONS = {
  "Agriculture & Développement": "leaf",
  "Inclusion Financière":         "users",
  "Cryptomonnaies & Blockchain":  "bitcoin",
  "Innovation Sociale":           "zap",
  "Économie du Développement":    "globe",
  "Économie Comportementale":     "target",
  "Technologies Émergentes":      "cpu",
  "Travail en Équipe":            "users",
};
const SERVICE_ICONS = ["chart","barChart","database","book","trendingUp","fileText"];
const EDU_ICONS = ["graduation","microscope","briefcase"];

/* ─────────────────────────────────────────────────────
   SECTION 1 — NAV
───────────────────────────────────────────────────── */
const Nav = () => {
  const [solid, setSolid] = useState(false);
  const [active, setActive] = useState("hero");
  useEffect(() => {
    const fn = () => {
      setSolid(window.scrollY > 60);
      const pos = window.scrollY + 130;
      let cur = "hero";
      NAV.forEach(([,id]) => {
        const el = document.getElementById(id);
        if (el && el.offsetTop <= pos) cur = id;
      });
      setActive(cur);
    };
    window.addEventListener("scroll", fn, { passive:true });
    return () => window.removeEventListener("scroll", fn);
  }, []);
  return (
    <nav id="nav" className={solid ? "solid" : ""}>
      <div className="nav-inner">
        <div className="nav-brand" onClick={() => go("hero")}>
          <div className="nav-mark">VA</div>
          <div>
            <div className="nav-name">Vincent Assogba</div>
            <div className="nav-sub">Économètre · Data Analyst</div>
          </div>
        </div>
        <div className="nav-links">
          {NAV.slice(0,7).map(([label,id]) => (
            <button key={id} className={`nav-btn${active===id?" active":""}`} onClick={() => go(id)}>{label}</button>
          ))}
        </div>
        <button className="btn btn-teal" style={{fontSize:13,padding:"9px 20px"}} onClick={() => go("contact")}>
          <Icon name="mail" size={15} color="#fff"/> Me contacter
        </button>
      </div>
    </nav>
  );
};

/* ─────────────────────────────────────────────────────
   SECTION 1 — HERO
───────────────────────────────────────────────────── */
const Hero = () => {
  const typed = useTyped();
  return (
    <section id="hero">
      <div className="hero-mesh"/>
      <div className="hero-grid"/>
      <div className="wrap">
        <div className="hero-inner">

          {/* Left */}
          <div>
            <div className="hero-eyebrow" style={{animation:"fadeUp .6s ease both"}}>
              <div style={{position:"relative",width:9,height:9}}>
                <div className="hero-pulse-ring"/>
                <div className="hero-pulse"/>
              </div>
              <span className="hero-eyebrow-text">Disponible · Abomey-Calavi, Bénin · 2026</span>
            </div>

            <h1 className="hero-name" style={{animation:"fadeUp .65s .1s ease both"}}>
              Adéchinan<br/>
              <span className="teal">Vincent</span><br/>
              Assogba
            </h1>

            <div className="hero-typed-row" style={{animation:"fadeUp .65s .2s ease both"}}>
              <span className="hero-typed">{typed}</span>
              <span className="hero-cursor"/>
            </div>

            <p className="hero-desc" style={{animation:"fadeUp .65s .3s ease both"}}>
              {PROFILE.tagline}
            </p>

            {/* 3 CTA buttons from cahier des charges §4 */}
            <div className="hero-btns" style={{animation:"fadeUp .65s .4s ease both"}}>
              <a href={ASSETS.cv} download="CV_Vincent_Assogba.pdf" className="btn btn-teal">
                <Icon name="download" size={16} color="#fff"/> Télécharger CV
              </a>
              <button className="btn btn-white" onClick={() => go("research")}>
                <Icon name="chart" size={16} color="rgba(255,255,255,.8)"/> Voir mes recherches
              </button>
              <button className="btn btn-ghost" style={{color:"rgba(255,255,255,.7)",borderColor:"rgba(255,255,255,.18)"}} onClick={() => go("contact")}>
                <Icon name="mail" size={16} color="rgba(255,255,255,.7)"/> Me contacter
              </button>
            </div>

            <div className="hero-meta" style={{animation:"fadeUp .65s .5s ease both"}}>
              {[
                {icon:"phone",    val:PROFILE.phone},
                {icon:"mail",     val:PROFILE.email},
                {icon:"mapPin",   val:PROFILE.address},
              ].map(m => (
                <div key={m.icon} className="hero-meta-row">
                  <Icon name={m.icon} size={14} color="rgba(255,255,255,.3)"/>
                  <strong>{m.val}</strong>
                </div>
              ))}
            </div>
          </div>

          {/* Right — Photo */}
          <div className="hero-photo-wrap" style={{animation:"zoomIn .8s .3s ease both"}}>
            <div className="hero-ring" style={{width:400,height:400,animationDuration:"28s"}}/>
            <div className="hero-ring" style={{width:490,height:490,animationDuration:"18s",animationDirection:"reverse",borderColor:"rgba(30,58,138,.1)"}}/>

            <div className="hero-blob">
              <img src={ASSETS.photo} alt="Vincent Assogba — Économètre"/>
            </div>

            <div className="hero-float-badge" style={{bottom:"56px",right:"-32px",animationDelay:"0s"}}>
              <div className="hfb-val">R² = 0.930</div>
              <div className="hfb-lbl">Modèle ARDL</div>
            </div>
            <div className="hero-float-badge" style={{top:"56px",left:"-28px",animationDelay:"1.2s"}}>
              <div className="hfb-val" style={{color:"#FBBF24"}}>F = 9.594</div>
              <div className="hfb-lbl">Fisher statistic</div>
            </div>
            <div className="hero-float-badge" style={{top:"38%",right:"-40px",animationDelay:".6s"}}>
              <div className="hfb-val" style={{color:"#A78BFA"}}>5+</div>
              <div className="hfb-lbl">Certifications</div>
            </div>
          </div>
        </div>
      </div>

      <div className="scroll-hint" onClick={() => go("about")}>
        <span>Scroll</span>
        <div className="scroll-hint-line"/>
      </div>
    </section>
  );
};

