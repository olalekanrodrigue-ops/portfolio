          ))}
        </div>
      </div>
    </section>
  );
};

/* ─────────────────────────────────────────────────────
   SECTION 12 — CONTACT
───────────────────────────────────────────────────── */
const Contact = () => {
  const [ref,vis] = useInView();
  const [form,setForm] = useState({name:"",email:"",subject:"",message:""});
  const [sent,setSent] = useState(false);

  const handleSend = () => {
    if (!form.name || !form.email) return;
    const body = `Bonjour M. Assogba,\n\nNom : ${form.name}\nEmail : ${form.email}\nSujet : ${form.subject}\n\n${form.message}`;
    window.location.href = `mailto:${PROFILE.email}?subject=${encodeURIComponent(form.subject||"Contact Portfolio")}&body=${encodeURIComponent(body)}`;
    setSent(true);
    setTimeout(() => setSent(false), 4000);
  };

  return (
    <section id="contact">
      <div className="wrap" ref={ref}>
        <div style={{textAlign:"center",marginBottom:52}} className={`reveal up${vis?" vis":""}`}>
          <div className="eyebrow" style={{justifyContent:"center"}}><div className="eyebrow-line"/>Contact</div>
          <h2 className="s-title" style={{textAlign:"center"}}>Travaillons <span className="accent">ensemble</span></h2>
          <p className="s-desc" style={{margin:"0 auto",textAlign:"center"}}>Disponible pour des missions de recherche, consulting, analyse économique ou collaboration avec des institutions internationales.</p>
        </div>

        <div className="contact-grid">
          {/* Info left */}
          <div className={`reveal left${vis?" vis":""} d1`}>
            {[
              {icon:"phone",  label:"Téléphone", val:PROFILE.phone,  href:`tel:${PROFILE.phone}`},
              {icon:"mail",   label:"Email",     val:PROFILE.email,  href:`mailto:${PROFILE.email}`},
              {icon:"mapPin", label:"Adresse",   val:PROFILE.address, href:null},
            ].map(item => (
              <div key={item.label} className="contact-info-item">
                <div className="ci-icon"><Icon name={item.icon} size={20} color="var(--teal)"/></div>
                <div>
                  <div className="ci-label">{item.label}</div>
                  {item.href
                    ? <a href={item.href} className="ci-val">{item.val}</a>
                    : <span className="ci-val">{item.val}</span>
                  }
                </div>
              </div>
            ))}

            {/* Réseaux §15 */}
            <div className="socials">
              {[
                {icon:"linkedin",   label:"LinkedIn",     href:PROFILE.linkedin},
                {icon:"github",     label:"GitHub",       href:PROFILE.github},
                {icon:"microscope", label:"ResearchGate", href:PROFILE.researchgate},
              ].map(s => (
                <a key={s.label} href={s.href} className="social-btn">
                  <Icon name={s.icon} size={15} color="var(--cobalt)"/>{s.label}
                </a>
              ))}
            </div>

            <div className="availability-box">
              <div className="avail-dot"/>
              <div>
                <div style={{fontWeight:700,fontSize:14,color:"var(--text)",marginBottom:4}}>Disponible pour missions</div>
                <p style={{fontSize:13,color:"var(--muted)",lineHeight:1.65}}>Ouvert aux collaborations avec BCEAO, Banque Mondiale, PNUD, AFD, ONG et centres de recherche.</p>
              </div>
            </div>
          </div>

          {/* Form right */}
          <div className={`reveal right${vis?" vis":""} d2`}>
            <div className="form-card">
              <h3 style={{fontFamily:"'DM Serif Display',serif",fontSize:22,fontWeight:400,color:"var(--navy)",marginBottom:24}}>Envoyer un message</h3>

              <div className="form-row">
                <div>
                  <label className="f-label">Nom *</label>
                  <input className="f-input" placeholder="Votre nom" value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/>
                </div>
                <div>
                  <label className="f-label">Email *</label>
                  <input className="f-input" type="email" placeholder="votre@email.com" value={form.email} onChange={e=>setForm({...form,email:e.target.value})}/>
                </div>
              </div>

              <div className="form-group">
                <label className="f-label">Sujet</label>
                <select className="f-input" value={form.subject} onChange={e=>setForm({...form,subject:e.target.value})}>
                  <option value="">Sélectionnez…</option>
                  <option>Proposition de collaboration</option>
                  <option>Offre de stage / emploi</option>
                  <option>Mission de consulting</option>
                  <option>Demande de recherche</option>
                  <option>Partenariat institutionnel</option>
                  <option>Autre</option>
                </select>
              </div>

              <div className="form-group">
                <label className="f-label">Message</label>
                <textarea className="f-input" rows={5} placeholder="Décrivez votre projet…" value={form.message} onChange={e=>setForm({...form,message:e.target.value})}/>
              </div>

              <button className="btn btn-teal" onClick={handleSend}
                disabled={!form.name||!form.email}
                style={{width:"100%",justifyContent:"center",fontSize:15,padding:"14px"}}>
                {sent
                  ? <><Icon name="check" size={17} color="#fff"/> Message envoyé !</>
                  : <><Icon name="send"  size={17} color="#fff"/> Envoyer le message</>
                }
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
};

/* ─────────────────────────────────────────────────────
   SECTION 13 — FOOTER
───────────────────────────────────────────────────── */
const Footer = () => (
  <footer>
    <div className="wrap">
      <div className="footer-inner">
        <div>
          <div className="footer-brand-name">Vincent Assogba</div>
          <div className="footer-brand-tag">Econometrician · Data Analyst · Economic Researcher</div>
        </div>
        <div className="footer-copy">© 2026 Adéchinan Vincent Assogba. Tous droits réservés.</div>
        <div className="footer-icons">
          {[
            {icon:"mail",       href:`mailto:${PROFILE.email}`},
            {icon:"phone",      href:`tel:${PROFILE.phone}`},
            {icon:"linkedin",   href:PROFILE.linkedin},
            {icon:"github",     href:PROFILE.github},
            {icon:"microscope", href:PROFILE.researchgate},
          ].map((l,i)=>(
            <a key={i} href={l.href} className="f-icon-btn">
              <Icon name={l.icon} size={16} color="rgba(255,255,255,.5)"/>
            </a>
          ))}
        </div>
      </div>
      <div className="footer-nav">
        {NAV.map(([label,id])=>(
          <button key={id} className="f-nav-btn" onClick={()=>go(id)}>{label}</button>
        ))}
      </div>
    </div>
  </footer>
);

/* ─────────────────────────────────────────────────────
   ROOT APP
   13 sections from portfolio-plan.md:
   Hero · About · Stats · Education · Skills · Tools ·
   Research · Certifications · Attestations · Services ·
   Interests · Contact · Footer
───────────────────────────────────────────────────── */
export default function App() {
  return (
    <>
      <GlobalCSS/>
      <Nav/>
      <main>
        <Hero/>          {/* 1  */}
        <About/>         {/* 2  */}
        <Stats/>         {/* 3  */}
        <Education/>     {/* 4  */}
        <Skills/>        {/* 5  */}
        <Tools/>         {/* 6  */}
        <Research/>      {/* 7  */}
        <Certifications/>{/* 8  */}
        <Attestations/>  {/* 9  */}
        <Services/>      {/* 10 */}
        <Interests/>     {/* 11 */}
        <Contact/>       {/* 12 */}
      </main>
      <Footer/>          {/* 13 */}
    </>
  );
}
