  return (
    <section id="certifications">
      <div className="wrap" ref={ref}>
        <div style={{marginBottom:52}} className={`reveal up${vis?" vis":""}`}>
          <div className="eyebrow"><div className="eyebrow-line"/>Certifications professionnelles</div>
