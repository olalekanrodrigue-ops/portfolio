───────────────────────────────────────────────────── */
const Research = () => {
  const [ref,vis] = useInView();
  return (
    <section id="research">
      <div className="wrap" ref={ref}>
        <div style={{marginBottom:52}} className={`reveal up${vis?" vis":""}`}>
          <div className="eyebrow"><div className="eyebrow-line"/>Travaux de recherche</div>
          <h2 className="s-title">Recherches & <span className="accent">Publications</span></h2>
          <p className="s-desc">Études économétriques appliquées à l'économie béninoise, mobilisant des méthodes rigoureuses et des données Banque Mondiale.</p>
        </div>

        <div className="research-grid">
          {RESEARCH.map((r,i) => (
            <div key={i} className={`rc reveal up${vis?" vis":""}`} style={{animationDelay:`${.1+i*.15}s`}}>
              <div className="rc-head">
                <div className="rc-head-glow"/>
                <div style={{display:"flex",justifyContent:"space-between",marginBottom:14,gap:10,flexWrap:"wrap"}}>
                  <span className={i===0?"tag":"tag tag-blue"} style={{fontSize:11}}>{r.badge}</span>
                  <span style={{fontFamily:"'JetBrains Mono',monospace",fontSize:10.5,color:"rgba(255,255,255,.4)"}}>{r.year}</span>
                </div>
                <h3 style={{fontFamily:"'DM Serif Display',serif",fontSize:17,fontWeight:400,color:"#fff",lineHeight:1.45,marginBottom:10}}>{r.title}</h3>
                <p style={{fontSize:13,color:"rgba(255,255,255,.5)",lineHeight:1.72}}>{r.abstract}</p>
              </div>
              <div className="rc-body">
                <div className="rc-metrics">
                  {r.metrics.map(m=>(
                    <div key={m.desc} className="rc-metric">
                      <div className="rc-mval">{m.val}</div>
                      <div className="rc-mdesc">{m.desc}</div>
                    </div>
                  ))}
                </div>
                <div className="rc-methods">
                  {r.methods.map(m=><span key={m} className="tag tag-blue" style={{fontSize:10}}>{m}</span>)}
                </div>
                <div className="rc-conclusion">
                  <div className="rc-concl-title">Résultats clés</div>
                  <p style={{fontSize:13,color:"var(--text)",lineHeight:1.7}}>{r.conclusion}</p>
                </div>
                <a href={ASSETS.research[r.pdfKey]} download={`${r.pdfKey}.pdf`} className="pdf-btn">
                  <Icon name="download" size={14} color="var(--teal)"/>
                  Télécharger PDF
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
};

