.social-btn:hover{background:var(--teal-ll);border-color:rgba(20,184,166,.3);color:var(--teal)}
.availability-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:20px 22px;margin-top:28px;display:flex;align-items:flex-start;gap:14px}
.avail-dot{width:10px;height:10px;border-radius:50%;background:#22C55E;animation:pulse 2s infinite;margin-top:2px;flex-shrink:0}
.form-card{background:var(--surface);border-radius:var(--r-xl);padding:36px;box-shadow:var(--shadow-md);border:1px solid var(--border)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.form-group{margin-bottom:14px}
.f-label{font-size:11.5px;font-weight:800;color:var(--text);letter-spacing:.4px;text-transform:uppercase;display:block;margin-bottom:7px;font-family:'JetBrains Mono',monospace}
.f-input{
  width:100%;padding:12px 15px;border-radius:var(--r-sm);
