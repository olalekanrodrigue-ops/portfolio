                  {e.school}
                </div>
                <p style={{fontSize:13.5,color:"var(--muted)",lineHeight:1.75,marginBottom:14}}>{e.desc}</p>
                <div style={{display:"flex",flexWrap:"wrap",gap:6}}>
                  {e.tags.map(t=><span key={t} className="tag tag-blue">{t}</span>)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
