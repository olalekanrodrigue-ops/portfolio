                <div className="tool-icon-wrap">
                  <Icon name={conf.icon} size={22} color={conf.color}/>
                </div>
                <div className="tool-name">{t.name}</div>
                <div className="tool-cat">{t.cat}</div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  );
};

/* ─────────────────────────────────────────────────────
